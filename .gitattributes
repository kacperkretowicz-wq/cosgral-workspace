patches/*.patch whitespace=-space-before-tab

# These generated contracts and the attested launcher are compared byte for
# byte by the runner build, including on Windows checkouts.
packages/paperclip-runner/src/providers/grok/launcher.cjs text eol=lf
packages/paperclip-runner/src/drivers/acpx/generated-*.ts text eol=lf
packages/paperclip-runner/src/contracts/*.generated.ts text eol=lf
packages/paperclip-runner/src/contracts/generated-*.ts text eol=lf
packages/paperclip-runner/src/protocol/generated/* text eol=lf
# Protocol manifest hashes the schema/fixture bytes, including line endings.
packages/paperclip-runner/protocol/**/*.json text eol=lf
packages/paperclip-runner/protocol/manifest.json text eol=lf
packages/paperclip-runner/src/generated/capability-contract.ts text eol=lf
packages/paperclip-runner/docs/capability-contract.md text eol=lf
packages/paperclip-runner/spec/capability/protocol-coverage.json text eol=lf
packages/paperclip-runner/generated/**/*.json text eol=lf
packages/paperclip-runner/generated/*.json text eol=lf
packages/paperclip-runner/runner/crates/runner-core/src/generated_*.rs text eol=lf
packages/shared/src/provider-failure.generated.ts text eol=lf

# Token/character generators compare these outputs byte for byte.
packages/shared/src/cliplab/palette-tokens.ts text eol=lf
packages/shared/src/cliplab/character.ts text eol=lf
