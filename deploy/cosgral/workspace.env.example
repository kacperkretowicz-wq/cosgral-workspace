# Install as /etc/cosgral/workspace.env, root:cosgral 0640.
# Replace every CHANGE_ME value on the server. Never commit the populated file.
DATABASE_URL=postgresql://cosgral:CHANGE_ME@127.0.0.1:5432/cosgral
PAPERCLIP_HOME=/var/lib/cosgral
HOST=127.0.0.1
PORT=3100
PAPERCLIP_BIND=loopback
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_PUBLIC_URL=https://CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
PAPERCLIP_AGENT_JWT_SECRET=CHANGE_ME
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=CHANGE_ME
PAPERCLIP_SECRETS_PROVIDER=local_encrypted
PAPERCLIP_SECRETS_MASTER_KEY_FILE=/var/lib/cosgral/secrets/master.key
PAPERCLIP_SECRETS_STRICT_MODE=true
SERVE_UI=true
# Apply migrations deliberately during maintenance, never in a restart loop.
PAPERCLIP_MIGRATION_PROMPT=never
PAPERCLIP_MIGRATION_AUTO_APPLY=false
